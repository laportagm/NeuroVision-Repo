{
  "// Cursor AI Configuration for NeuroVision Educational Platform": "",
  "// These settings enhance AI assistance for medical education development": "",

  "// AI Provider Settings": "",
  "cursor.aiProvider": "anthropic",
  "cursor.aiModel": "claude-4-sonnet",
  "cursor.contextWindow": "large",
  "cursor.temperature": 0.7,

  "// Context Management": "",
  "cursor.includeOpenTabs": true,
  "cursor.includeRecentFiles": true,
  "cursor.maxContextFiles": 20,
  "cursor.contextTimeout": 300000,

  "// Preferred Context Files (most important for AI understanding)": "",
  "cursor.preferredContextFiles": [
    "CLAUDE.md",
    ".cursorrules",
    "project.godot",
    "src/autoload/UnifiedColorManager.gd",
    "src/autoload/KnowledgeService.gd",
    "src/core/managers/CoreSystemManager.gd",
    "src/core/managers/UISystemManager.gd",
    "src/core/managers/EducationalPlatformManager.gd",
    "assets/data/anatomical_data.json"
  ],

  "// Code Generation Preferences": "",
  "cursor.generateTests": true,
  "cursor.includeErrorHandling": true,
  "cursor.preferredCodeStyle": "explicit",
  "cursor.generateDocstrings": false,
  "cursor.includeTypeHints": false,

  "// Chat & Interaction Settings": "",
  "cursor.chatHistory": true,
  "cursor.chatContextAwareness": "high",
  "cursor.chatResponseLength": "detailed",
  "cursor.showSources": true,

  "// Project-Specific Instructions": "",
  "cursor.customInstructions": {
    "medical": "Always validate medical terminology against Terminologia Anatomica standards",
    "performance": "Ensure all features maintain 60fps performance with brain models",
    "accessibility": "Include WCAG 2.1 AA compliance in all UI implementations",
    "education": "Consider learning objectives and educational effectiveness",
    "autoloads": "Always check autoload availability before using singleton services",
    "themes": "Support both Enhanced (student) and Minimal (professional) themes",
    "testing": "Include debug console commands for feature validation",
    "errors": "Use push_error/push_warning instead of print statements"
  },

  "// File Pattern Priorities": "",
  "cursor.priorityPatterns": [
    "src/autoload/**/*.gd",
    "src/core/managers/**/*.gd",
    "src/ui_atomic/**/*.gd",
    "scenes/**/*.tscn"
  ],

  "// Excluded Patterns (redundant with .cursorignore)": "",
  "cursor.excludePatterns": [
    ".godot/**",
    "**/*.import",
    "releases/**",
    "exports/**"
  ],

  "// Code Review Settings": "",
  "cursor.codeReview": {
    "checkMedicalAccuracy": true,
    "validateAccessibility": true,
    "enforceNamingConventions": true,
    "requireErrorHandling": true
  },

  "// Autocomplete Settings": "",
  "cursor.autocomplete": {
    "enabled": true,
    "triggerDelay": 200,
    "includeGodotAPI": true,
    "includeMedicalTerms": true,
    "prioritizeProjectSymbols": true
  },

  "// Inline Suggestions": "",
  "cursor.inlineSuggestions": {
    "enabled": true,
    "showInComments": false,
    "showInStrings": true,
    "maxLength": 100
  },

  "// Medical & Educational Context": "",
  "cursor.domainKnowledge": {
    "neuroanatomy": true,
    "medicalEducation": true,
    "clinicalRelevance": true,
    "educationalPsychology": true
  },

  "// Development Workflow": "",
  "cursor.workflow": {
    "preferEditOverCreate": true,
    "validateBeforeCommit": true,
    "runTestsAutomatically": false,
    "formatOnSave": false
  },

  "// Performance Monitoring": "",
  "cursor.performanceHints": {
    "enabled": true,
    "fpsThreshold": 60,
    "memoryThreshold": 500,
    "loadTimeThreshold": 3000
  },

  "// Educational Feature Development": "",
  "cursor.educationalFeatures": {
    "includeLearningSuggestions": true,
    "validateEducationalContent": true,
    "suggestAssessmentQuestions": true,
    "checkClinicalAccuracy": true
  }
}
