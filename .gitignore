# Godot
.godot/
.import/
export.cfg
export_presets.cfg
*.uid  # Godot editor generates these unique identifier files

# Environment files (NEVER commit these)
.env
.env.local
.env.*.local
.env.production
.env.development

# But allow example/template files
!.env.example
!.env.template

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/snippets/
!.vscode/cursor-settings.json
!.vscode/*.md


# Certificates and secrets
*.p12
*.pem
*.key
