# NeuroVision Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control

# API Keys (obtain from respective services)
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_key_here_if_needed
ANTHROPIC_API_KEY=your_anthropic_key_here_if_needed

# Development Settings
GODOT_DEBUG_PORT=6007
ENABLE_DEBUG_MODE=true
ENABLE_ANALYTICS=false
LOG_LEVEL=info  # Options: debug, info, warning, error

# Feature Flags
ENABLE_AI_ASSISTANT=false
ENABLE_CLOUD_SYNC=false
ENABLE_MULTIPLAYER=false
ENABLE_EXPERIMENTAL_FEATURES=false

# Educational Settings
DEFAULT_EDUCATIONAL_LEVEL=medical_student  # Options: beginner, medical_student, professional
ENABLE_ASSESSMENT_TOOLS=true
ENABLE_PROGRESS_TRACKING=true
ENABLE_CLINICAL_MODE=true

# Performance Settings
MAX_FPS=60
TEXTURE_QUALITY=high  # Options: low, medium, high, ultra
SHADOW_QUALITY=medium  # Options: disabled, low, medium, high
ANTIALIASING=4x  # Options: disabled, 2x, 4x, 8x
ENABLE_VSYNC=true

# Database Configuration
DATABASE_URL=sqlite://data/neurovision.db
ENABLE_DATABASE_LOGGING=false
DATABASE_POOL_SIZE=10

# Analytics (optional - for educational metrics)
ANALYTICS_ENDPOINT=
ANALYTICS_API_KEY=
ANALYTICS_BATCH_SIZE=100

# Medical Content API (optional - for additional content)
MEDICAL_API_ENDPOINT=
MEDICAL_API_KEY=
MEDICAL_API_TIMEOUT=30

# Security Settings
ENABLE_SSL=true
SESSION_TIMEOUT=3600  # 1 hour in seconds
ENABLE_AUDIT_LOG=true
