# Cursor AI Context Optimization
# Files and patterns to ignore for better AI performance

# Godot generated files
.godot/
*.tmp
*.import
.import/

# Build outputs
releases/
exports/
build/
dist/
*.exe
*.pck
*.zip
*.app
*.dmg
*.AppImage

# Binary assets (AI can't read these)
*.glb
*.gltf
*.blend
*.blend1
*.obj
*.fbx
*.dae
*.3ds
*.stl

# Image files
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.ico
*.svg
*.webp

# Audio files
*.wav
*.ogg
*.mp3
*.m4a
*.flac
*.aac

# Video files
*.mp4
*.avi
*.mov
*.mkv
*.webm

# Font files
*.ttf
*.otf
*.woff
*.woff2
*.eot

# OS files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.Spotlight-V100
.Trashes

# Documentation images
docs/images/
docs/screenshots/
docs/diagrams/

# Large data files
*.db
*.sqlite
*.sql
*.csv
*.xlsx
*.xls

# Temporary files
*.backup
*.bak
*.cache
*.log
*.tmp
.temp/
temp/

# IDE specific
.idea/
*.iml
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Dependencies
addons/
node_modules/
vendor/
packages/

# Archives
*.tar
*.tar.gz
*.rar
*.7z

# Godot specific binary formats
*.res
*.scn
*.material
*.mesh

# Test results
test-results/
coverage/
*.coverage
.nyc_output/

# Certificates and keys (security)
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12

# Lock files (version specific)
package-lock.json
yarn.lock
Gemfile.lock
poetry.lock