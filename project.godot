; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NeuroVis"
config/description="Educational Neuroanatomy Learning Application"
run/main_scene="res://src/ui/screens/MainMenu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

UnifiedColorManager="*res://src/autoload/UnifiedColorManager.gd"
CoreSystemManager="*res://src/core/managers/CoreSystemManager.gd"
UISystemManager="*res://src/core/managers/UISystemManager.gd"
EducationalPlatformManager="*res://src/core/managers/EducationalPlatformManager.gd"
ResourceManager="*res://src/core/managers/ResourceManager.gd"
#EssentialServices(keptseparateforspecializedfunctionality)AuthenticationManager="*res://src/autoload/AuthenticationManager.gd"
NetworkManager="*res://src/autoload/NetworkManager.gd"
AssessmentService="*res://src/systems/assessment/AssessmentService.gd"
HighlightMaterialManager="*res://src/systems/3d_interaction/HighlightMaterialManager.gd"
ProgressTracker="*res://src/autoload/ProgressTracker.gd"

[debug]

settings/network/remote_port=6008
settings/network/max_clients=1
settings/crashes_and_errors/max_errors_per_second=20

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

