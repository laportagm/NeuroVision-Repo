  "troubleshooting_tree": {
    "app_wont_start": {
      "check": "Godot console for parse errors",
      "then": "Verify project.godot autoload paths exist",
      "then2": "Check for circular dependencies in autoloads",
      "then3": "Run './tools/scripts/quick_test.sh' for validation",
      "finally": "Delete .godot/ folder and reimport"
    },
    "poor_performance": {
      "check": "F1 → performance (should show 60+ FPS)",
      "then": "F1 → models (check LOD levels)",
      "then2": "Verify GPU with GPUDetector.gd output",
      "then3": "Force LOW quality in settings",
      "finally": "Disable shaders in project settings"
    },
    "ui_not_responsive": {
      "check": "F1 → tree UI_Layer (verify structure)",
      "then": "Check if theme is loaded (UnifiedColorManager)",
      "then2": "Verify atomic components are instantiated",
      "then3": "Check for blocking operations in _process()",
      "finally": "Enable debug overlays for UI bounds"
    },
    "models_not_loading": {
      "check": "Verify files exist in assets/3d_models/",
      "then": "Check ModelPaths.gd configuration",
      "then2": "Test with SafeModelLoader in isolation",
      "then3": "Check ResourceManager cache status",
      "finally": "Try loading raw model directly"
    },
    "theme_issues": {
      "check": "UnifiedColorManager initialization in console",
      "then": "Verify M3DesignTokens loaded",
      "then2": "Check for theme override conflicts",
      "then3": "Test theme switching with F10",
      "finally": "Reset to default theme"
    }
  },
