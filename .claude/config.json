  "ai_guidance": {
    "preferred_patterns": {
      "error_handling": "Always use push_error() with [ModuleName] prefix",
      "resource_loading": "Use ResourceManager for all asset loading",
      "ui_creation": "Use atomic components from ui_atomic/",
      "cleanup": "Always implement _exit_tree() for resource cleanup",
      "model_loading": "Use SafeModelLoader for error-tolerant loading",
      "color_access": "Use UnifiedColorManager.get_color() for all colors",
      "progress_tracking": "Use ProgressTracker for all user progress",
      "accessibility": "Include accessible_name and accessible_role metadata"
    },
    "anti_patterns": {
      "avoid": [
        "Direct file loading without ResourceManager",
        "Creating UI without atomic components",
        "Using legacy KB instead of KnowledgeService",
        "Hardcoding paths instead of using ModelPaths",
        "Manual color values instead of theme system",
        "Direct theme_override without cleanup",
        "Free() instead of queue_free()",
        "Missing _exit_tree() in custom nodes"
      ]
    },
    "code_generation_rules": {
      "always_include": ["docstrings", "error_handling", "type_hints", "signal documentation"],
      "naming_format": "snake_case for files, PascalCase for classes",
      "max_function_length": 50,
      "max_file_length": 500,
      "comment_style": "## for class docs, # for inline",
      "organization": "signals → enums → constants → exports → onready → private vars → public methods → private methods"
    }
  },
  "common_tasks": {
    "add_new_brain_structure": {
      "steps": [
        "1. Add entry to assets/data/anatomical_data.json",
        "2. Add model path to ModelPaths.gd BRAIN_MODELS dict",
        "3. Place model files in assets/3d_models/processed/",
        "4. Test with 'knowledge structure_name' in debug console",
        "5. Verify in EnhancedExplorationScene"
      ],
      "files_to_modify": [
        "assets/data/anatomical_data.json",
        "src/core/config/ModelPaths.gd"
      ],
      "example_entry": {
        "id": "structure_id",
        "displayName": "Structure Name",
        "shortDescription": "Brief educational description",
        "functions": ["Function 1", "Function 2"],
        "clinicalRelevance": "Medical importance"
      }
    },
    "add_ui_component": {
      "steps": [
        "1. Create atom in ui_atomic/atoms/category/ComponentName.gd",
        "2. Extend appropriate base (Control, Button, Panel, etc)",
        "3. Include accessibility metadata exports",
        "4. Implement theme support via UnifiedColorManager",
        "5. Add to appropriate molecule/organism if needed",
        "6. Create .tscn if complex component"
      ],
      "required_features": ["WCAG compliance", "theme support", "responsive", "_exit_tree cleanup"],
      "template": "See code_templates.ui_component"
    },
    "fix_performance_issue": {
      "checklist": [
        "Run GPUDetector to identify hardware",
        "Check LOD level with ModelLoader",
        "Verify shader complexity in ui_atomic/effects/shaders/",
        "Monitor with PerformanceMonitor (F1 → performance)",
        "Test on Intel UHD 620 equivalent",
        "Use Godot profiler for bottlenecks",
        "Check for RID leaks in console"
      ],
      "common_solutions": [
        "Force LOW LOD for Intel GPUs",
        "Reduce shader passes",
        "Implement object pooling",
        "Add _exit_tree() cleanup"
      ]
    },
    "add_new_theme": {
      "steps": [
        "1. Add theme variant to M3DesignTokens.gd",
        "2. Define color palette following Material 3",
        "3. Ensure WCAG AAA contrast ratios",
        "4. Test with M3AccessibilityValidator",
        "5. Add to theme cycle in UIThemeManager"
      ],
      "validation": "Run 'test ui_safety' after adding"
    }
  },
  "system_dependencies": {
    "UnifiedColorManager": {
      "depends_on": ["M3DesignTokens", "UnifiedColorSystem"],
      "used_by": ["all UI components", "theme system", "shaders"],
      "critical_for": ["theme switching", "accessibility", "visual consistency"],
      "initialization": "autoload (early in order)"
    },
    "KnowledgeService": {
      "depends_on": ["anatomical_data.json"],
      "used_by": ["info panels", "quiz system", "AI assistant", "structure selection"],
      "replaces": ["AnatomicalKnowledgeDatabase (legacy KB)"],
      "api": "get_structure(), search_structures(), get_all_structures()"
    },
    "SafeModelLoader": {
      "depends_on": ["ModelPaths", "ResourceManager"],
      "used_by": ["EnhancedExplorationScene", "model preview systems"],
      "fallback": ["creates error placeholder on failure"],
      "modes": ["BLOCKING", "ASYNC", "BACKGROUND"]
    },
    "ProgressTracker": {
      "depends_on": ["SimplePersistence"],
      "used_by": ["assessment system", "UI panels", "achievements"],
      "persistence": "user://progress_save.dat",
      "autosave": "every 30 seconds"
    },
    "ResourceManager": {
      "depends_on": [],
      "used_by": ["all systems loading resources"],
      "cache_policies": ["PERMANENT", "TEMPORARY", "SESSION"],
      "max_cache": "256MB"
    }
  },
