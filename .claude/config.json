{
  "project_name": "NeuroVision",
  "project_type": "godot_educational_platform",
  "engine_version": "4.4.1",
  "language": "gdscript",
  "context_files": [
    "docs/PROJECT_OUTLINE.md",
    "docs/CLAUDE.md",
    "docs/QUICK_PROMPT_REFERENCE.md",
    "PROJECT_STRUCTURE.md",
    "PROFESSIONAL_UI_IMPLEMENTATION_REPORT.md",
    "COLOR_SYSTEM_MIGRATION_COMPLETE.md",
    "ARCHITECTURAL_IMPROVEMENTS_REPORT.md",
    "NEUROVISION_ARCHITECTURE_DIAGRAM.md"
  ],
  "key_systems": [
    "src/autoload/UIThemeManager.gd",
    "src/autoload/PerformanceMonitor.gd",
    "src/autoload/AccessibilityManager.gd",
    "src/systems/3d_interaction/BrainInteractionController.gd",
    "src/ui/themes/M3DesignTokens.gd",
    "src/systems/assessment/AssessmentService.gd"
  ],
  "prompt_engineering": {
    "quick_reference": "docs/QUICK_PROMPT_REFERENCE.md",
    "phase_prompts": "prompts/phase1_implementation.md",
    "architecture_docs": "NEUROVISION_ARCHITECTURE_DIAGRAM.md"
  },
  "development_approach": "mature_platform_enhancement",
  "current_phase": "phase_2_advanced_features",
  "completed_systems": [
    "material_3_ui_system",
    "3d_brain_interaction",
    "educational_content_management",
    "accessibility_framework",
    "performance_optimization",
    "responsive_design",
    "theme_system"
  ],
  "excluded_features": ["firebase", "cloud_sync", "google_oauth"],
  "validation_on_commit": true,
  "performance_target": {
    "min_fps": 60,
    "achieved_fps": 120,
    "target_hardware": "Intel UHD 620",
    "max_load_time": 3.0,
    "max_memory_usage_gb": 2.0
  },
  "accessibility_requirements": {
    "wcag_level": "AAA",
    "keyboard_navigation": true,
    "screen_reader": true,
    "high_contrast": true,
    "responsive_ui": true,
    "color_blind_support": true
  },
  "educational_requirements": {
    "target_audience": "medical_students_and_professionals",
    "accuracy_level": "medical_textbook",
    "offline_capable": true,
    "assessment_system": true,
    "progress_tracking": true
  },
  "ui_framework": {
    "design_system": "Material 3",
    "theme_modes": ["enhanced", "minimal", "high_contrast"],
    "responsive_breakpoints": true,
    "animation_system": true
  },
  "architecture_highlights": [
    "comprehensive_autoload_system",
    "modular_ui_components",
    "advanced_3d_interaction",
    "educational_content_pipeline",
    "performance_monitoring",
    "accessibility_first_design"
  ],
  "development_tools": {
    "launch_script": "launch_helper.sh",
    "project_runner": "run_project.sh", 
    "testing_setup": "scripts/setup_gut.sh",
    "progress_tracker": "scripts/update_progress.sh"
  },
  "testing_framework": {
    "primary": "GUT",
    "test_runner": "addons/gut/gut_cmdln.gd",
    "manual_checklist": "docs/guides/MANUAL_TEST_CHECKLIST.md"
  },
  "content_structure": {
    "brain_database": "content/brain_structures.json",
    "assessments": "content/assessments/",
    "learning_paths": "content/learning_paths/",
    "progress_tracking": "docs/status/PROJECT_PROGRESS.md"
  },
  "educational_features": {
    "brain_structures": 5,
    "assessment_types": ["multiple_choice", "interactive_3d"],
    "learning_objectives": true,
    "clinical_relevance": true
  },
  "asset_management": {
    "3d_models": "assets/3d_models/",
    "model_optimization": "LOD_system_with_performance_tiers",
    "shaders": "assets/shaders/",
    "ui_resources": "assets/ui/",
    "themes": "src/ui/themes/"
  },
  "shader_system": {
    "medical_visualization": "assets/shaders/medical_visualization.gdshader",
    "highlight_effects": "assets/shaders/structure_highlight/",
    "ui_effects": "src/ui/effects/shaders/"
  },
  "data_management": {
    "sqlite_integration": "sqlite_mcp_server.db",
    "content_format": "JSON",
    "progress_persistence": "SimplePersistence.gd",
    "user_data": "local_storage_only"
  },
  "quality_assurance": {
    "accessibility_validation": "src/ui/themes/M3AccessibilityValidator.gd",
    "performance_monitoring": "src/autoload/PerformanceMonitor.gd",
    "color_system_validation": "src/ui/themes/ColorSystemValidator.gd",
    "gpu_compatibility": "src/systems/3d_interaction/GPUDetector.gd"
  },
  "deployment": {
    "export_platforms": ["Windows", "macOS", "Linux"],
    "launch_modes": ["standard", "enhanced_explorer", "performance_test", "debug"],
    "distribution_method": "standalone_executable",
    "hardware_requirements": "Intel_UHD_620_minimum"
  },
  "documentation_hierarchy": {
    "developer_guides": "docs/guides/",
    "api_documentation": "docs/api/",
    "architecture": "docs/architecture.md",
    "performance_optimization": "docs/INTEL_UHD_620_PERFORMANCE_OPTIMIZATION.md",
    "accessibility": "docs/ACCESSIBILITY_IMPLEMENTATION.md"
  },
  "environment_setup": {
    "godot_version": "4.4.1",
    "required_features": ["GL_Compatibility", "Metal_support"],
    "development_scripts": "scripts/",
    "editor_configuration": "Godot/editor_settings-4.4.tres"
  },
  "error_management": {
    "recovery_system": "src/autoload/ErrorRecoveryManager.gd",
    "logging": "Godot/app_userdata/NeuroVis/logs/",
    "graceful_degradation": true,
    "user_feedback": "integrated_error_reporting"
  },
  "performance_metrics": {
    "target_fps": 60,
    "achieved_fps": 120,
    "memory_limit": "2GB",
    "dynamic_quality": true,
    "hardware_detection": "automatic",
    "optimization_levels": ["LOW", "MEDIUM", "HIGH", "ULTRA"]
  },
  "active_autoloads": {
    "core_managers": [
      "UnifiedColorManager",
      "CoreSystemManager", 
      "UISystemManager",
      "EducationalPlatformManager",
      "ResourceManager"
    ],
    "specialized_services": [
      "AuthenticationManager",
      "NetworkManager", 
      "AssessmentService",
      "HighlightMaterialManager",
      "ProgressTracker"
    ]
  },
  "input_configuration": {
    "3d_interaction": "left_click_select",
    "camera_controls": "right_click_rotate",
    "zoom": "mouse_wheel",
    "accessibility": "full_keyboard_navigation"
  },
  "rendering_settings": {
    "anti_aliasing": "MSAA_3D_with_TAA", 
    "texture_compression": "ETC2_ASTC",
    "anisotropic_filtering": "4x",
    "screen_space_aa": "enabled",
    "debanding": "enabled"
  }
}