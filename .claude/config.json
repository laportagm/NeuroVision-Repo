    "common_issues": {
      "rid_leaks": {
        "symptom": "RID leak warnings on exit",
        "solution": "Add _exit_tree() to custom nodes, use remove_theme_*_override()",
        "check": "grep -r 'add_theme_.*_override' --include='*.gd'"
      },
      "model_not_found": {
        "symptom": "Model file not found errors",
        "solution": "Verify ModelPaths.gd configuration and file exists",
        "check": "ls assets/3d_models/processed/"
      },
      "ui_not_showing": {
        "symptom": "UI panels not visible",
        "solution": "Check InfoPanelFactory, verify scene tree, check theme",
        "check": "tree UI_Layer in debug console"
      },
      "autoload_errors": {
        "symptom": "Script errors on startup",
        "solution": "Check project.godot autoload paths",
        "check": "Verify all autoload scripts exist and parse correctly"
      },
      "shader_compilation": {
        "symptom": "Shader compilation errors in console",
        "solution": "Check for proper vec3/vec4 conversions, use COLOR.rgb for vec3",
        "check": "Look for brain_tissue_advanced.gdshader errors",
        "fixed_in": "brain_tissue_advanced.gdshader v2.0"
      },
      "missing_hdri": {
        "symptom": "Environment looks flat or missing reflections",
        "solution": "Verify HDRI files exist in assets/hdri/",
        "check": "ls assets/hdri/*.hdr"
      }
    }
  },
