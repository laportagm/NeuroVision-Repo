  "code_templates": {
    "new_autoload": {
      "template": "extends Node\\n\\n## Autoload service description\\n\\nsignal example_signal()\\n\\n# === CONSTANTS ===\\nconst EXAMPLE_CONST = 'value'\\n\\n# === PRIVATE VARIABLES ===\\nvar _internal_state = {}\\n\\nfunc _ready() -> void:\\n\\tprint('[ServiceName] Initializing...')\\n\\t# Setup code here\\n\\tprint('[ServiceName] Ready')\\n\\nfunc _exit_tree() -> void:\\n\\t# Cleanup code here\\n\\tpass",
      "required_methods": ["_ready", "_exit_tree"],
      "naming": "PascalCaseManager or PascalCaseService"
    },
    "ui_component": {
      "template": "class_name ComponentName\\nextends Control\\n\\n## Component description\\n\\n# === EXPORTS ===\\n@export var accessible_name: String = ''\\n@export var accessible_role: String = 'button'\\n\\nfunc _ready() -> void:\\n\\t_apply_theme()\\n\\t_setup_accessibility()\\n\\nfunc _apply_theme() -> void:\\n\\tvar color = UnifiedColorManager.get_color('primary')\\n\\t# Apply theme\\n\\nfunc _setup_accessibility() -> void:\\n\\tset_meta('accessible_name', accessible_name)\\n\\tset_meta('accessible_role', accessible_role)\\n\\nfunc _exit_tree() -> void:\\n\\t# Clean up theme overrides\\n\\tpass",
      "required_exports": ["@export var accessible_name: String"],
      "must_extend": "Control or Node3D"
    },
    "example_snippets": {
      "load_model": "var loader = SafeModelLoader.new()\\nvar model = loader.load_brain_model('Internal-Structures', 'low')",
      "get_color": "var primary = UnifiedColorManager.get_color('primary')\\nvar surface = UnifiedColorManager.get_color('surface')",
      "track_progress": "ProgressTracker.update_progress('hippocampus', 0.75)\\nProgressTracker.achievement_unlocked('first_structure')",
      "show_info": "var panel = preload('res://src/ui_atomic/organisms/StructureInfoPanel.tscn').instantiate()\\npanel.display_structure_info(structure_data)",
      "error_handling": "if not resource:\\n\\tpush_error('[ModuleName] Failed to load resource')\\n\\treturn",
      "cleanup_pattern": "func _exit_tree() -> void:\\n\\tif _timer:\\n\\t\\t_timer.stop()\\n\\t\\t_timer.queue_free()\\n\\t_cache.clear()"
    }
  },
